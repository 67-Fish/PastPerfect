<div class="page-header">
  <h1 class="page-title">Dashboard</h1>
  <p class="page-subtitle">Welcome back, <%= user?.email?.split('@')[0] || 'User' %>! Here's what's happening with your school's archive.</p>
</div>

<div class="dashboard-stats" role="region" aria-label="Statistics">
  <article class="stat-card">
    <div class="stat-icon stat-icon-primary">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
    </div>
    <div class="stat-content">
      <div class="stat-value" id="stat-papers"></div>
      <div class="stat-label">Total Papers</div>
    </div>
  </article>
  
  <article class="stat-card">
    <div class="stat-icon stat-icon-secondary">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
    </div>
    <div class="stat-content">
      <div class="stat-value" id="stat-subjects"></div>
      <div class="stat-label">Subjects</div>
    </div>
  </article>
  
  <article class="stat-card">
    <div class="stat-icon stat-icon-success">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div class="stat-content">
      <div class="stat-value" id="stat-published"></div>
      <div class="stat-label">Published</div>
    </div>
  </article>
  
  <article class="stat-card">
    <div class="stat-icon stat-icon-warning">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div class="stat-content">
      <div class="stat-value" id="stat-drafts"></div>
      <div class="stat-label">Drafts</div>
    </div>
  </article>
</div>

<div class="dashboard-sections">
  <section class="dashboard-section" aria-labelledby="recent-papers-heading">
    <header class="dashboard-section-header">
      <h2 id="recent-papers-heading" class="dashboard-section-title">Recent Papers</h2>
      <a href="/papers" class="dashboard-section-action btn btn-link">View all</a>
    </header>
    <div class="dashboard-section-body">
      <div class="dashboard-empty" id="recent-papers-empty">
        <svg class="dashboard-empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <h3 class="dashboard-empty-title">No papers yet</h3>
        <p class="dashboard-empty-text">Upload your first past paper to get started.</p>
        <% if (user?.roles?.includes('admin') || user?.roles?.includes('schoolAdmin') || user?.roles?.includes('teacher')) { %>
          <a href="/papers/upload" class="btn btn-primary mt-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a1 1 0 011-1h12a1 1 0 110 2H8a1 1 0 01-1-1z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4a1 1 0 011-1h12a1 1 0 011 1v4m-4 8l-4-4m0 0L8 8m4-4v12"/></svg>
            Upload Paper
          </a>
        <% } %>
      </div>
      <div class="table-container" id="recent-papers-table" style="display: none;">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">Title</th>
              <th scope="col">Subject</th>
              <th scope="col">Year</th>
              <th scope="col">Status</th>
              <th scope="col"></th>
            </tr>
          </thead>
          <tbody id="recent-papers-body"></tbody>
        </table>
      </div>
    </div>
  </section>
  
  <section class="dashboard-section" aria-labelledby="quick-actions-heading">
    <header class="dashboard-section-header">
      <h2 id="quick-actions-heading" class="dashboard-section-title">Quick Actions</h2>
    </header>
    <div class="dashboard-section-body">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <% if (user?.roles?.includes('admin') || user?.roles?.includes('schoolAdmin') || user?.roles?.includes('teacher')) { %>
          <a href="/papers/upload" class="card p-5 hover:shadow-md transition-all duration-200 group">
            <div class="flex items-center gap-4">
              <div class="stat-icon stat-icon-primary group-hover:scale-110 group-hover:rotate-5 transition-all duration-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a1 1 0 011-1h12a1 1 0 110 2H8a1 1 0 01-1-1z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4a1 1 0 011-1h12a1 1 0 011 1v4m-4 8l-4-4m0 0L8 8m4-4v12"/></svg>
              </div>
              <div>
                <h3 class="font-title font-semibold text-navy group-hover:text-sky transition-colors">Upload Paper</h3>
                <p class="text-sm text-muted">Add a new past paper to the archive</p>
              </div>
            </div>
          </a>
        <% } %>
        
        <a href="/papers" class="card p-5 hover:shadow-md transition-all duration-200 group">
          <div class="flex items-center gap-4">
            <div class="stat-icon stat-icon-secondary group-hover:scale-110 group-hover:rotate-5 transition-all duration-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </div>
            <div>
              <h3 class="font-title font-semibold text-navy group-hover:text-sky transition-colors">Browse Papers</h3>
              <p class="text-sm text-muted">Search and filter the archive</p>
            </div>
          </div>
        </a>
        
        <a href="/study" class="card p-5 hover:shadow-md transition-all duration-200 group">
          <div class="flex items-center gap-4">
            <div class="stat-icon stat-icon-success group-hover:scale-110 group-hover:rotate-5 transition-all duration-300">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            </div>
            <div>
              <h3 class="font-title font-semibold text-navy group-hover:text-sky transition-colors">Study Tools</h3>
              <p class="text-sm text-muted">Practice with timed exams</p>
            </div>
          </div>
        </a>
        
        <% if (user?.roles?.includes('schoolAdmin') || user?.roles?.includes('admin')) { %>
          <a href="/school/users" class="card p-5 hover:shadow-md transition-all duration-200 group">
            <div class="flex items-center gap-4">
              <div class="stat-icon stat-icon-warning group-hover:scale-110 group-hover:rotate-5 transition-all duration-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
              </div>
              <div>
                <h3 class="font-title font-semibold text-navy group-hover:text-sky transition-colors">Manage Users</h3>
                <p class="text-sm text-muted">Add teachers and students</p>
              </div>
            </div>
          </a>
        <% } %>
      </div>
    </div>
  </section>
</div>

<script type="module">
import { api } from '/public/js/api.js';

async function loadDashboard() {
  try {
    const [papersRes, subjectsRes] = await Promise.all([
      api.get('/api/papers?limit=5&orderBy=created_at&orderDir=DESC'),
      api.get('/api/subjects?limit=100')
    ]);
    
    const papers = papersRes.data || [];
    const subjects = subjectsRes.data || [];
    
    // Update stats with animation
    animateValue('stat-papers', papersRes.total || 0);
    animateValue('stat-subjects', subjects.length || 0);
    animateValue('stat-published', papers.filter(p => p.status === 'published').length);
    animateValue('stat-drafts', papers.filter(p => p.status === 'draft').length);
    
    // Recent papers table
    if (papers.length > 0) {
      document.getElementById('recent-papers-empty').style.display = 'none';
      document.getElementById('recent-papers-table').style.display = 'block';
      
      const tbody = document.getElementById('recent-papers-body');
      tbody.innerHTML = papers.map((paper, index) => `
        <tr style="animation: fadeInUp 0.5s ease forwards ${index * 0.1}s; opacity: 0;">
          <td>
            <a href="/papers/${paper.id}" class="font-medium text-navy hover:text-sky">${paper.title}</a>
          </td>
          <td>${paper.subject_name || ''}</td>
          <td>${paper.exam_series_year || ''}</td>
          <td><span class="badge badge-${paper.status === 'published' ? 'success' : paper.status === 'draft' ? 'warning' : 'outline'}">${paper.status}</span></td>
          <td>
            <a href="/papers/${paper.id}" class="btn btn-outline btn-sm">View</a>
          </td>
        </tr>
      `).join('');
      
      // Trigger animations
      setTimeout(() => {
        document.querySelectorAll('#recent-papers-body tr').forEach(row => {
          row.style.opacity = '1';
        });
      }, 100);
    }
  } catch (err) {
    console.error('Failed to load dashboard:', err);
  }
}

// Animate number counting
function animateValue(elementId, target) {
  const el = document.getElementById(elementId);
  const duration = 1000;
  const start = 0;
  const startTime = performance.now();
  
  function update(currentTime) {
    const elapsed = currentTime - startTime;
    const progress = Math.min(elapsed / duration, 1);
    const easeOutQuart = 1 - Math.pow(1 - progress, 4);
    const current = Math.floor(start + (target - start) * easeOutQuart);
    
    el.textContent = current;
    
    if (progress < 1) {
      requestAnimationFrame(update);
    }
  }
  
  requestAnimationFrame(update);
}

loadDashboard();
</script>

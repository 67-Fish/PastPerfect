<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="PastPerfect - School Past Papers Archive">
  <title><%= title %></title>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
  
  <!-- Design System CSS -->
  <link rel="stylesheet" href="/public/css/design-tokens.css">
  <link rel="stylesheet" href="/public/css/components.css">
  <link rel="stylesheet" href="/public/css/utilities.css">
  <link rel="stylesheet" href="/public/css/app.css">
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
</head>
<body class="bg-cream min-h-screen flex flex-col">
  <%- include('../partials/navbar', { user: user, currentPath: req?.originalUrl }) %>
  
  <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <%- include('../partials/flash-messages') %>
    <%- body %>
  </main>
  
  <%- include('../partials/footer') %>
  
  <!-- Alpine.js for minimal interactivity -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  
  <!-- App JS -->
  <script src="/public/js/app.js" type="module"></script>
</body>
</html>